# Copy to backend/.env and fill in. NEVER commit the real .env — it is gitignored.

# --- core ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="app"
CORS_ORIGINS="*"
APP_URL=http://localhost:3000
# Use false for local HTTP development. Set true on HTTPS deployments.
COOKIE_SECURE=false

# --- secrets: generate your own, e.g. `openssl rand -hex 32` ---
JWT_SECRET=
APP_MASTER_KEY=
# --- Gemini models (ordered fallback chain; free tier is 20 req/model/day) ---
GEMINI_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- optional: transactional email for employee invites ---
# Without a key, invite links are shown in the admin UI instead of emailed.
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# --- optional: demo provider credentials used by `python seed.py` ---
# These are seeded (encrypted) onto the demo tenant so the agent pipeline works
# out of the box. Omit any of them and seed.py simply skips that provider.
# Get a Gemini key free at https://aistudio.google.com/apikey
SEED_GEMINI_API_KEY=
# Qdrant Cloud free tier: https://cloud.qdrant.io
SEED_QDRANT_API_KEY=
SEED_QDRANT_URL=
# PageIndex: https://dash.pageindex.ai
SEED_PAGEINDEX_API_KEY=
